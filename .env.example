# Optional overrides. Without a token, a random one is saved to .data/.studio-token.
CB_STUDIO_TOKEN=
CB_DATA_DIR=.data
CB_COOKIE_SECURE=false
CB_FFMPEG=ffmpeg
CB_FFPROBE=ffprobe
# Optional OpenAI-compatible writing provider. Core features need no API key.
CB_AI_BASE_URL=
CB_AI_API_KEY=
CB_AI_MODEL=
